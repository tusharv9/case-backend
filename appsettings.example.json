{
    "ConnectionStrings": {
        "DefaultConnection": "Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Command Timeout=90;Keepalive=30;"
    },
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173",
    "AllowedHosts": "localhost",
    "HostIntegration": {
        "Mode": "Standalone",
        "Jwt": {
            "Authority": "https://<host-identity-provider>",
            "Audience": "case-management",
            "Issuer": null
        },
        "Claims": { "UserId": "sub", "Name": "name", "Email": "email", "Roles": "role", "Permissions": "permissions" },
        "Directory": { "BaseUrl": null, "ListPath": "/users", "GetPath": "/users/{id}", "SyncIntervalMinutes": 0 },
        "RolePermissions": {
            "Agent": ["cases.read", "cases.write", "customers.read", "customers.write"],
            "Supervisor": ["cases.read", "cases.write", "cases.assign", "customers.read", "customers.write", "monitoring.view", "monitoring.nudge", "audit.view", "teams.manage"],
            "Admin": ["*"]
        }
    },
    "Database": {
        "MigrateOnStartup": true,
        "Seed": "Development",
        "ConnectTimeoutSeconds": 120
    },
    "EnableSwagger": false,
    "Search": { "MinQueryLength": 2, "DefaultResultLimit": 10, "MaxResultLimit": 50 },
    "LookupCache": { "DepartmentsCacheSeconds": 300 },
    "Attachments": {
        "MaxFileSizeBytes": 26214400,
        "AllowedExtensions": ".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.gif,.bmp,.zip,.rar,.7z,.msg,.eml"
    },
    "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
