# Case Management API — local settings. Copy to .env (git-ignored) and fill in.
# Every key is an ordinary ASP.NET Core setting: a double underscore is a section separator.

# Run inside the OmniConnect Host: identity comes from the Host-issued RS256 JWT.
# Leave this out (appsettings.json says Standalone) only for the standalone development user picker.
HostIntegration__Mode=Host
HostIntegration__AppKey=casemanagement

# The OmniConnect platform public key — the same value every service's .env carries (AuthService's
# public key). One line with \n escapes, or a quoted multi-line PEM.
Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# Listen port. Locally launchSettings gives 5110; the container listens on 8080 (ASPNETCORE_URLS=http://+:8080 in
# the platform image, Backend/Dockerfile.case; this repo's own Dockerfile sets ASPNETCORE_HTTP_PORTS=8080).
# Set CASE_PORT only to override that. A generic PORT inherited from the shell is ignored on purpose.
# CASE_PORT=5110

# Published by the host dev server / nginx under this prefix (the unprefixed /api still works).
Hosting__PathBase=/api/casemanagement-service

ConnectionStrings__DefaultConnection=

# Customer 360: existing customers are read from Customer360Service with the caller's own token.
Customer360__BaseUrl=http://localhost:5059

# Customer 360 identifiers stored on cases (NRIC/BRN…) are encrypted, plus a keyed hash for lookups.
# Each is 32 random bytes, base64 (openssl rand -base64 32). Keep them in the secret store and BACK THEM UP:
# losing EncryptionKey makes stored identifiers unreadable. Every instance sharing the database needs the same values.
CustomerIdentifiers__EncryptionKey=
CustomerIdentifiers__HashKey=

# The Host user directory (AuthService), read with the signed-in person's token when choosing team members.
AuthService__BaseUrl=http://localhost:5155
